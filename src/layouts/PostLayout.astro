---
import BaseLayout from './BaseLayout.astro';

interface AdjacentPost {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  pubDate: Date;
  tags?: string[];
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
}

const { title, description, image, pubDate, tags, prevPost, nextPost } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} image={image} type="article">
  <div class="page-wrap">
    <article>
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {tags && tags.length > 0 && (
            <span class="tags">
              {tags.map(tag => <span class="tag">{tag}</span>)}
            </span>
          )}
        </div>
      </header>
      <div class="post-body">
        <slot />
      </div>
    </article>
    <nav class="post-nav">
      {(prevPost || nextPost) && (
        <div class="post-nav-adjacent">
          <div class="post-nav-prev">
            {prevPost && (
              <a href={`/notes/${prevPost.slug}`}>
                <span class="post-nav-label">&larr; Previous</span>
                <span class="post-nav-title">{prevPost.title}</span>
              </a>
            )}
          </div>
          <div class="post-nav-next">
            {nextPost && (
              <a href={`/notes/${nextPost.slug}`}>
                <span class="post-nav-label">Next &rarr;</span>
                <span class="post-nav-title">{nextPost.title}</span>
              </a>
            )}
          </div>
        </div>
      )}
      <a href="/notes" class="post-nav-all">All notes</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-code-bg);
    padding: 0.1em 0.5em;
    border-radius: 3px;
    font-size: 0.8rem;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    margin-top: 2rem;
  }

  .post-body :global(.highlight) {
    font-size: 1.35rem;
    font-weight: 600;
    font-style: italic;
    line-height: 1.5;
    margin-block: 1.75rem;
  }

  @media (min-width: 1280px) {
    .post-body :global(.highlight) {
      margin-inline: -2.5rem;
    }
  }

  .post-body::after {
    content: '';
    display: table;
    clear: both;
  }

  .post-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .post-nav a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .post-nav a:hover {
    color: var(--color-text);
  }

  .post-nav-adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .post-nav-prev {
    text-align: left;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-prev a,
  .post-nav-next a {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .post-nav-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .post-nav-all {
    display: block;
    text-align: center;
    font-size: 0.8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>
