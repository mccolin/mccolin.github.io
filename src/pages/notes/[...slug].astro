---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('notes', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const sorted = posts.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[index - 1],
      nextPost: sorted[index + 1],
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

const ogImage = post.data.image
  ? (await getImage({ src: post.data.image, width: 1200, format: 'jpeg' })).src
  : undefined;
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  prevPost={prevPost ? { slug: prevPost.id, title: prevPost.data.title } : undefined}
  nextPost={nextPost ? { slug: nextPost.id, title: nextPost.data.title } : undefined}
>
  <Content />
</PostLayout>
